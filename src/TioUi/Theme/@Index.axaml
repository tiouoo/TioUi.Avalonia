<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Controls/Basic/@Basic.axaml" />
                <ResourceInclude Source="Controls/Tio/@Tio.axaml" />
                <ResourceInclude Source="Controls/ColorPicker/@ColorPicker.axaml" />
                <ResourceInclude Source="Controls/DataGrid/DataGrid.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <StyleInclude Source="Styles/@Styles.axaml" />
    <tio:ScrollViewDefaultTheme />
</Styles>